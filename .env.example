NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only on the server.  Create a Supabase service-role key and a Resend API key
# in the deployment environment; never expose either as NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_FROM_EMAIL=ระบบทุนการศึกษา <notifications@your-verified-domain.example>
NOTIFICATION_DISPATCH_SECRET=generate-a-long-random-secret
